# macOS
.DS_Store

# documents/ was local-only (business docs, considered sensitive) until 2026-09-22, when the user
# explicitly decided to publish all of it on this public repo — scanned first for secrets (none
# found), see the HANDOFF.md/README.md commit history around that date for the prior policy.
documents/.obsidian/

# Claude Code local session/agent config — not project source
.claude/

# iOS (ios/ has its own .gitignore for Xcode-specific patterns —
# DerivedData, generated Laju.xcodeproj, xcuserdata, .build, .swiftpm)

# Backend (Next.js/TypeScript, tech-spec.md §1) — empty until T2.1, these
# patterns are here ready for when it's populated
backend/node_modules/
backend/.next/
backend/dist/
backend/.env
backend/.env.local
backend/.env*.local
backend/npm-debug.log*
backend/.vercel/
backend/tsconfig.tsbuildinfo
backend/next-env.d.ts

# Supabase CLI local link state (T2.1) — `.temp/` holds session-local
# project-ref/pooler-url cache from `supabase link`; standard Supabase CLI
# convention is to never commit it.
backend/supabase/.temp/
backend/supabase/.branches/
